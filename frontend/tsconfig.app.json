{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Off, and only because of generated code: wailsjs/go/models.ts is written
    // by `wails build` as TypeScript namespaces, which erasableSyntaxOnly
    // refuses. Vite transpiles them fine; the flag only matters for runtimes
    // that strip types without compiling, which nothing here is.
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  // wailsjs/ is generated by `wails build`; it is typechecked as part of the
  // app because the shell calls into it. Tests are checked by tsconfig.test.json,
  // with Bun's types instead of Vite's.
  "include": ["src", "wailsjs"],
  "exclude": ["src/**/*.test.ts"]
}
